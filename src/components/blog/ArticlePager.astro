---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../lib/site-config";
import { resolveRoute } from "../../i18n/routes";

export interface Props {
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
  locale: Locale;
}

const { previous, next, locale } = Astro.props as Props;
---

{
  (previous || next) && (
    <nav class="article-pager" aria-label="Learning path pagination">
      {previous ? (
        <a
          class="article-pager__link article-pager__link--previous"
          href={resolveRoute(locale, `/blog/${previous.id}/`)}
        >
          <span class="article-pager__direction">
            <span aria-hidden="true">&larr;</span>
            Previous lesson
          </span>
          <span>{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}

      {next && (
        <a
          class="article-pager__link article-pager__link--next"
          href={resolveRoute(locale, `/blog/${next.id}/`)}
        >
          <span class="article-pager__direction">
            Next lesson
            <span aria-hidden="true">&rarr;</span>
          </span>
          <span>{next.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .article-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    padding-block: var(--space-lg);
    border-block: 1px solid var(--border);
  }

  .article-pager__link {
    display: grid;
    gap: var(--space-xs);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .article-pager__link:hover > :last-child {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: var(--spacing-1);
  }

  .article-pager__link--next {
    text-align: right;
  }

  .article-pager__direction {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .article-pager {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .article-pager__link--next {
      text-align: left;
    }
  }
</style>
