---
import type { CollectionEntry } from "astro:content";
import { getResearchTopic } from "../../lib/research-topics";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const topic = post.data.topic ? getResearchTopic(post.data.topic) : undefined;
const hasGuide =
  topic &&
  (post.data.learningObjectives.length > 0 ||
    post.data.prerequisites.length > 0 ||
    post.data.labEnvironment);
---

{
  hasGuide && topic && (
    <section class="article-guide" aria-labelledby="article-guide-title">
      <header class="article-guide__head">
        <div>
          <p class="article-guide__eyebrow">Before you start</p>
          <h2 id="article-guide-title">Learning brief</h2>
        </div>
        <a class="article-guide__path" href={`/topics/${topic.id}/`}>
          {topic.shortTitle} path
          <span aria-hidden="true">&rarr;</span>
        </a>
      </header>

      <div class="article-guide__body">
        {post.data.learningObjectives.length > 0 && (
          <section aria-labelledby="learning-outcomes-title">
            <h3 id="learning-outcomes-title">What you will learn</h3>
            <ol class="article-guide__objectives">
              {post.data.learningObjectives.map((objective: string) => (
                <li>{objective}</li>
              ))}
            </ol>
          </section>
        )}

        <section aria-labelledby="prerequisites-title">
          <h3 id="prerequisites-title">Prerequisites</h3>
          {post.data.prerequisites.length > 0 ? (
            <ul>
              {post.data.prerequisites.map((prerequisite: string) => (
                <li>{prerequisite}</li>
              ))}
            </ul>
          ) : (
            <p>No formal prerequisites are listed for this lesson.</p>
          )}
        </section>
      </div>

      {post.data.labEnvironment && (
        <section
          class="article-guide__boundary"
          aria-labelledby="safe-lab-boundary-title"
        >
          <h3 id="safe-lab-boundary-title">Safe lab boundary</h3>
          <p>{post.data.labEnvironment}</p>
        </section>
      )}
    </section>
  )
}

<style>
  .article-guide {
    display: grid;
    gap: var(--space-md);
    margin-block: calc(var(--space-md) * -1) 0;
    padding-block: var(--space-lg);
    border-block: 1px solid var(--border);
  }

  .article-guide__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .article-guide__eyebrow,
  .article-guide__head h2,
  .article-guide__body h3,
  .article-guide__body p,
  .article-guide__boundary h3,
  .article-guide__boundary p {
    margin: 0;
  }

  .article-guide__eyebrow {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .article-guide__head h2 {
    margin-top: var(--space-xs);
    font-size: var(--text-article-h3);
  }

  .article-guide__path {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-underline-offset: var(--spacing-1);
  }

  .article-guide__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.65fr);
    gap: var(--space-xl);
  }

  .article-guide__body h3,
  .article-guide__boundary h3 {
    font-size: var(--text-sm);
  }

  .article-guide__objectives,
  .article-guide__body ul {
    display: grid;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 0;
    padding-left: var(--space-lg);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .article-guide__body p,
  .article-guide__boundary p {
    margin-top: var(--space-xs);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .article-guide__boundary {
    display: grid;
    grid-template-columns: minmax(7rem, 0.25fr) minmax(0, 1fr);
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .article-guide__boundary p {
    margin-top: 0;
  }

  @media (max-width: 48rem) {
    .article-guide {
      padding-block: var(--space-md);
    }

    .article-guide__head,
    .article-guide__body,
    .article-guide__boundary {
      grid-template-columns: 1fr;
    }

    .article-guide__head {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .article-guide__body {
      gap: var(--space-lg);
    }
  }
</style>
