---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";
import BlogImageSVG from "./BlogImageSVG.astro";
import { type Locale } from "../../lib/site-config";
import { t } from "../../i18n/ui";
import { getBlogReadingStats } from "../../lib/blog-presentation";
import { getResearchTopic } from "../../lib/research-topics";
import { Badge } from "../ui";

export interface Props {
  post: CollectionEntry<"blog">;
  locale?: Locale;
}

const { post, locale = post.data.locale } = Astro.props as Props;
const publishDate = new Date(post.data.publishDate);
const updatedDate = post.data.updatedAt
  ? new Date(post.data.updatedAt)
  : undefined;
const reading = getBlogReadingStats(post.body ?? "", post.data.format);
const topic = post.data.topic ? getResearchTopic(post.data.topic) : undefined;
const dateLabel = publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updatedLabel = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<header class="article-hero">
  <div class="article-hero__content">
    {
      topic && (
        <div class="article-hero__classification">
          <a href={`/topics/${topic.id}/`}>{topic.shortTitle}</a>
          {post.data.difficulty && (
            <Badge variant="outline" size="sm">
              {post.data.difficulty}
            </Badge>
          )}
          {post.data.seriesOrder && (
            <span>Lesson {String(post.data.seriesOrder).padStart(2, "0")}</span>
          )}
        </div>
      )
    }
    <h1>{post.data.title}</h1>
    <p class="article-hero__description">{post.data.description}</p>

    <div class="article-hero__meta">
      <span class="article-hero__author">{post.data.author}</span>
      <span class="article-hero__dot" aria-hidden="true">&middot;</span>
      <time datetime={publishDate.toISOString()}>{dateLabel}</time>
      {
        updatedDate && updatedDate.getTime() !== publishDate.getTime() && (
          <>
            <span class="article-hero__dot" aria-hidden="true">
              &middot;
            </span>
            <span>
              Updated{" "}
              <time datetime={updatedDate.toISOString()}>{updatedLabel}</time>
            </span>
          </>
        )
      }
      <span class="article-hero__dot" aria-hidden="true">&middot;</span>
      <span>
        {
          reading
            ? t(locale, "blog.minutesRead").replace(
                "{n}",
                String(reading.minutes),
              )
            : t(locale, "blog.interactiveAtlas")
        }
      </span>
    </div>

    {!topic && <TagList tags={post.data.tags ?? []} locale={locale} />}
  </div>

  {
    !topic && (
      <figure class="article-hero__media">
        <BlogImageSVG
          slug={post.data.svgSlug ?? post.id}
          title={post.data.title}
        />
      </figure>
    )
  }
</header>

<style>
  .article-hero {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: 0;
  }

  .article-hero__content {
    display: grid;
    gap: var(--space-sm);
    max-width: 52rem;
  }

  .article-hero__classification {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .article-hero__classification a {
    color: var(--foreground);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .article-hero__classification a:hover {
    text-decoration: underline;
    text-underline-offset: var(--space-xs);
  }

  .article-hero__classification a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .article-hero h1 {
    margin: 0;
    max-width: 24ch;
    font-size: var(--text-article-title);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .article-hero__description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-article-description);
    line-height: var(--leading-relaxed);
    max-width: 42rem;
    text-wrap: pretty;
  }

  .article-hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .article-hero__author {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .article-hero__dot {
    opacity: 0.5;
  }

  .article-hero__media {
    margin: 0;
    aspect-ratio: 1200 / 540;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
  }

  .article-hero__media :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
