---
import { getCollection, type CollectionEntry } from "astro:content";
import { resolveRoute } from "../../i18n/routes";
import { getBlogReadingStats } from "../../lib/blog-presentation";
import { RESEARCH_TOPICS } from "../../lib/research-topics";
import type { Locale } from "../../lib/site-config";
import { Container, Section } from "../ui";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props as Props;
const now = Date.now();
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");
const posts = allPosts
  .filter(
    (post) =>
      post.data.locale === locale &&
      !post.data.draft &&
      post.data.publishDate.getTime() <= now,
  )
  .sort(
    (a, b) =>
      (b.data.updatedAt ?? b.data.publishDate).getTime() -
        (a.data.updatedAt ?? a.data.publishDate).getTime() ||
      a.data.title.localeCompare(b.data.title, "en"),
  )
  .map((post) => {
    const topic = RESEARCH_TOPICS.find(
      (candidate) => candidate.id === post.data.topic,
    );
    return {
      post,
      topic,
      reading: getBlogReadingStats(post.body ?? "", post.data.format),
      href: resolveRoute(locale, `/blog/${post.id}/`),
      searchIndex: [
        post.data.title,
        post.data.description,
        post.data.author,
        post.data.content_type,
        post.data.status,
        post.data.difficulty,
        topic?.title,
        ...post.data.tags,
        ...post.data.cves,
      ]
        .filter(Boolean)
        .join(" ")
        .toLocaleLowerCase("en-US"),
    };
  });

const unique = (values: Array<string | undefined>) =>
  [...new Set(values.filter((value): value is string => Boolean(value)))].sort(
    (a, b) => a.localeCompare(b, "en"),
  );
const contentTypes = unique(posts.map(({ post }) => post.data.content_type));
const topics = unique(posts.map(({ topic }) => topic?.title));
const difficulties = unique(posts.map(({ post }) => post.data.difficulty));
const statuses = unique(posts.map(({ post }) => post.data.status));
const humanize = (value: string) =>
  value
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
---

<Section spacing="xl" class="published-directory-section">
  <Container size="xl">
    <div class="published-directory" data-published-blog-directory>
      <header class="published-directory__intro">
        <p class="published-directory__eyebrow">Article library</p>
        <h1>Browse lessons and research notes</h1>
        <p>
          Filter by learning path, difficulty, content type, or review state.
          Preliminary material remains visible, but it is never presented as
          independently confirmed.
        </p>
      </header>

      {
        posts.length > 0 ? (
          <>
            <form
              class="published-directory__toolbar"
              role="search"
              data-library-filters
              data-pagefind-ignore
            >
              <label class="published-directory__search">
                <span>Search this list</span>
                <input
                  type="search"
                  name="query"
                  placeholder="Title, summary, API, CVE, or tag"
                  autocomplete="off"
                  data-library-query
                />
              </label>

              <label>
                <span>Learning path</span>
                <select name="topic" data-library-topic>
                  <option value="">All paths</option>
                  {topics.map((topic) => (
                    <option value={topic}>{topic}</option>
                  ))}
                </select>
              </label>

              <label>
                <span>Difficulty</span>
                <select name="difficulty" data-library-difficulty>
                  <option value="">All levels</option>
                  {difficulties.map((difficulty) => (
                    <option value={difficulty}>{difficulty}</option>
                  ))}
                </select>
              </label>

              <label>
                <span>Content type</span>
                <select name="type" data-library-type>
                  <option value="">All types</option>
                  {contentTypes.map((type) => (
                    <option value={type}>{humanize(type)}</option>
                  ))}
                </select>
              </label>

              <label>
                <span>Review state</span>
                <select name="status" data-library-status>
                  <option value="">All states</option>
                  {statuses.map((status) => (
                    <option value={status}>{humanize(status)}</option>
                  ))}
                </select>
              </label>

              <button type="reset">Reset filters</button>
            </form>

            <div class="published-directory__result-bar" data-pagefind-ignore>
              <p role="status" aria-live="polite" data-library-result-status>
                Showing all {posts.length} entries.
              </p>
              <a href="/data/published-blogs.json">JSON feed</a>
            </div>

            <ol
              class="published-directory__list"
              data-library-list
              data-pagefind-ignore
            >
              {posts.map(({ post, topic, reading, href, searchIndex }) => {
                const updated = post.data.updatedAt ?? post.data.publishDate;
                return (
                  <li
                    data-library-entry
                    data-search={searchIndex}
                    data-topic={topic?.title ?? ""}
                    data-difficulty={post.data.difficulty ?? ""}
                    data-type={post.data.content_type}
                    data-status={post.data.status}
                  >
                    <a href={href}>
                      <span class="published-entry__copy">
                        <strong>{post.data.title}</strong>
                        <span>{post.data.description}</span>
                      </span>
                      <dl>
                        <div>
                          <dt>Path</dt>
                          <dd>{topic?.shortTitle ?? "Reference"}</dd>
                        </div>
                        <div>
                          <dt>Type</dt>
                          <dd>{humanize(post.data.content_type)}</dd>
                        </div>
                        <div>
                          <dt>Level</dt>
                          <dd>{post.data.difficulty ?? "Not assigned"}</dd>
                        </div>
                        <div>
                          <dt>Review</dt>
                          <dd>{humanize(post.data.status)}</dd>
                        </div>
                        <div>
                          <dt>Updated</dt>
                          <dd>
                            <time datetime={updated.toISOString()}>
                              {dateFormatter.format(updated)}
                            </time>
                          </dd>
                        </div>
                        <div>
                          <dt>Time</dt>
                          <dd>
                            {reading ? `${reading.minutes} min` : "Interactive"}
                          </dd>
                        </div>
                      </dl>
                    </a>
                  </li>
                );
              })}
            </ol>

            <p class="published-directory__empty" data-library-empty hidden>
              No entry matches every selected filter.
            </p>
          </>
        ) : (
          <p>No articles have been published yet.</p>
        )
      }
    </div>
  </Container>
</Section>

<script is:inline>
  {
    const directory = document.querySelector("[data-published-blog-directory]");
    const form = directory?.querySelector("[data-library-filters]");
    const entries = [
      ...(directory?.querySelectorAll("[data-library-entry]") || []),
    ];
    const status = directory?.querySelector("[data-library-result-status]");
    const empty = directory?.querySelector("[data-library-empty]");

    const normalize = (value) => value.trim().toLocaleLowerCase("en-US");

    const applyFilters = () => {
      if (!form) return;
      const data = new FormData(form);
      const query = normalize(String(data.get("query") || ""));
      const topic = String(data.get("topic") || "");
      const difficulty = String(data.get("difficulty") || "");
      const type = String(data.get("type") || "");
      const reviewState = String(data.get("status") || "");
      let visible = 0;

      entries.forEach((entry) => {
        const matches =
          (!query || normalize(entry.dataset.search || "").includes(query)) &&
          (!topic || entry.dataset.topic === topic) &&
          (!difficulty || entry.dataset.difficulty === difficulty) &&
          (!type || entry.dataset.type === type) &&
          (!reviewState || entry.dataset.status === reviewState);
        entry.hidden = !matches;
        if (matches) visible += 1;
      });

      if (status) {
        status.textContent =
          visible === entries.length
            ? `Showing all ${visible} entries.`
            : `Showing ${visible} of ${entries.length} entries.`;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    form?.addEventListener("input", applyFilters);
    form?.addEventListener("change", applyFilters);
    form?.addEventListener("reset", () => {
      window.requestAnimationFrame(applyFilters);
    });
  }
</script>

<style>
  .published-directory {
    display: grid;
    gap: var(--space-2xl);
  }

  .published-directory__intro {
    max-width: var(--measure-reading-wide);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .published-directory__eyebrow {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .published-directory__intro h1 {
    max-width: 20ch;
    margin: var(--space-sm) 0 0;
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .published-directory__intro > p:last-child {
    max-width: 64ch;
    margin: var(--space-md) 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-reading);
    line-height: var(--leading-reading);
  }

  .published-directory__toolbar {
    display: grid;
    grid-template-columns:
      minmax(18rem, 1.5fr) repeat(4, minmax(9rem, 1fr))
      auto;
    gap: var(--space-md);
    align-items: end;
  }

  .published-directory__toolbar label {
    display: grid;
    gap: var(--space-xs);
  }

  .published-directory__toolbar label > span {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .published-directory__toolbar input,
  .published-directory__toolbar select,
  .published-directory__toolbar button {
    min-width: 0;
    min-height: var(--control-md);
    padding-inline: var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-sm);
  }

  .published-directory__toolbar button {
    cursor: pointer;
  }

  .published-directory__toolbar input:focus-visible,
  .published-directory__toolbar select:focus-visible,
  .published-directory__toolbar button:focus-visible,
  .published-directory a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .published-directory__result-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--border);
  }

  .published-directory__result-bar p,
  .published-directory__empty {
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }

  .published-directory__result-bar a {
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .published-directory__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .published-directory__list > li {
    border-bottom: 1px solid var(--border);
  }

  .published-directory__list > li[hidden] {
    display: none;
  }

  .published-directory__list > li > a {
    display: grid;
    grid-template-columns: minmax(22rem, 1.1fr) minmax(34rem, 0.9fr);
    gap: var(--space-2xl);
    padding-block: var(--space-lg);
    color: inherit;
    text-decoration: none;
  }

  .published-directory__list > li > a:hover {
    background: var(--muted);
  }

  .published-entry__copy {
    display: grid;
    gap: var(--space-xs);
  }

  .published-entry__copy strong {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .published-entry__copy > span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .published-directory__list dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(7rem, 1fr));
    gap: var(--space-sm);
    align-content: start;
    margin: 0;
  }

  .published-directory__list dl div {
    min-width: 0;
  }

  .published-directory__list dt {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .published-directory__list dd {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-sm);
  }

  @media (max-width: 76rem) {
    .published-directory__toolbar {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .published-directory__search {
      grid-column: span 2;
    }

    .published-directory__list > li > a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 48rem) {
    .published-directory {
      gap: var(--space-xl);
    }

    .published-directory__toolbar {
      grid-template-columns: minmax(0, 1fr);
    }

    .published-directory__search {
      grid-column: auto;
    }

    .published-directory__list dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
