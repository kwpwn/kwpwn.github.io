---
import { getCollection, type CollectionEntry } from "astro:content";
import { resolveRoute } from "../../i18n/routes";
import { getBlogReadingStats } from "../../lib/blog-presentation";
import {
  getResearchTopicPosts,
  RESEARCH_TOPICS,
  type ResearchTopicId,
} from "../../lib/research-topics";
import type { Locale } from "../../lib/site-config";
import { Container, Section } from "../ui";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props as Props;
const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

const pathOrder: ResearchTopicId[] = [
  "windows-internals",
  "windows-privesc",
  "malware-c2",
];

const pathDetails: Record<
  ResearchTopicId,
  { level: string; prerequisites: string; goal: string }
> = {
  "windows-internals": {
    level: "Foundation to advanced",
    prerequisites: "Windows basics and a disposable VM",
    goal: "Explain Windows behavior through objects, transitions, and trust boundaries.",
  },
  "windows-privesc": {
    level: "Intermediate",
    prerequisites: "Processes, tokens, ACLs, and service basics",
    goal: "Audit privilege boundaries and build evidence-backed escalation models.",
  },
  "malware-c2": {
    level: "Intermediate",
    prerequisites: "Windows basics, networking, and an isolated lab",
    goal: "Analyze execution, persistence, telemetry, and C2 as observable systems.",
  },
};

const learningPaths = pathOrder.map((id) => {
  const topic = RESEARCH_TOPICS.find((candidate) => candidate.id === id)!;
  return {
    topic,
    posts: getResearchTopicPosts(allPosts, id),
    ...pathDetails[id],
  };
});

const recentlyUpdated = allPosts
  .filter((post) => post.data.locale === locale && !post.data.draft)
  .sort(
    (a, b) =>
      (b.data.updatedAt ?? b.data.publishDate).getTime() -
      (a.data.updatedAt ?? a.data.publishDate).getTime(),
  )
  .slice(0, 6);

const tasks = [
  {
    title: "Understand a Windows subsystem",
    description:
      "Start with the concept model, then follow its related lessons.",
    href: "/windows-security-concepts/",
  },
  {
    title: "Audit a Windows service",
    description:
      "Inspect identity, hosting, endpoints, permissions, and version context.",
    href: "/windows-service-vulnerabilities/",
  },
  {
    title: "Analyze an IPC boundary",
    description:
      "Study ALPC, RPC, COM, named pipes, and impersonation preconditions.",
    href: "/topics/windows-internals/#ipc-services",
  },
  {
    title: "Reverse a driver",
    description:
      "Follow I/O requests, device stacks, buffering, and trust decisions.",
    href: "/topics/windows-internals/#io-drivers",
  },
  {
    title: "Study a vulnerability",
    description:
      "Browse case studies without treating unverified claims as fact.",
    href: "/windows-security-case-studies/",
  },
  {
    title: "Build an evidence-backed lab",
    description:
      "Define a baseline, controls, observations, and retained evidence.",
    href: "/windows-security-concepts/research-evidence/",
  },
  {
    title: "Look up a concept",
    description:
      "Use the handbook for definitions, distinctions, and related material.",
    href: "/windows-security-concepts/",
  },
  {
    title: "Find service CVEs",
    description:
      "Search the Service Atlas by service family, component, or CVE.",
    href: "/windows-service-vulnerabilities/",
  },
] as const;

const standards = [
  {
    term: "Documented fact",
    definition:
      "Supported by an official contract, specification, header, or advisory.",
  },
  {
    term: "Observed behavior",
    definition:
      "Recorded on a named Windows build, architecture, tool, and execution context.",
  },
  {
    term: "Inference",
    definition:
      "A conclusion derived from evidence with alternatives and limits made explicit.",
  },
  {
    term: "Hypothesis",
    definition:
      "An unconfirmed explanation paired with a way to test or reject it.",
  },
] as const;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const humanize = (value: string) =>
  value
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
---

<Section spacing="xl" class="library-home-section">
  <Container size="xl">
    <div class="library-home">
      <header class="library-home__hero">
        <p class="library-home__eyebrow">Windows security learning library</p>
        <h1>Learn Windows security through evidence, not folklore.</h1>
        <p class="library-home__lead">
          Structured lessons, concept references, service dossiers, and research
          notes for Windows internals, privilege boundaries, malware analysis,
          and vulnerability research.
        </p>

        <button
          type="button"
          class="library-home__search"
          data-search-trigger
          aria-label="Search the research library"
        >
          <span>Search concepts, APIs, services, CVEs, and lessons</span>
          <kbd>Ctrl K</kbd>
        </button>

        <div class="library-home__actions">
          <a
            class="library-home__primary"
            href={resolveRoute(locale, "/topics/windows-internals/")}
          >
            Start learning <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={resolveRoute(locale, "/blogs/")}>Browse library</a>
        </div>
      </header>

      <section class="library-home__section" aria-labelledby="paths-title">
        <header class="library-home__section-heading">
          <p class="library-home__eyebrow">Continue or start learning</p>
          <h2 id="paths-title">Three guided paths</h2>
          <p>
            Follow a sequence when you want depth, or use the task and reference
            indexes below when you need a direct answer.
          </p>
        </header>

        <ol class="library-home__paths">
          {
            learningPaths.map(
              ({ topic, posts, level, prerequisites, goal }, index) => (
                <li>
                  <a href={resolveRoute(locale, `/topics/${topic.id}/`)}>
                    <span class="library-home__path-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="library-home__path-copy">
                      <strong>{topic.title}</strong>
                      <span>{goal}</span>
                    </span>
                    <dl>
                      <div>
                        <dt>Level</dt>
                        <dd>{level}</dd>
                      </div>
                      <div>
                        <dt>Structure</dt>
                        <dd>
                          {topic.tracks.length} modules · {posts.length} lessons
                        </dd>
                      </div>
                      <div>
                        <dt>Before you start</dt>
                        <dd>{prerequisites}</dd>
                      </div>
                    </dl>
                    <span class="library-home__path-arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                </li>
              ),
            )
          }
        </ol>
      </section>

      <section class="library-home__section" aria-labelledby="tasks-title">
        <header class="library-home__section-heading">
          <p class="library-home__eyebrow">Browse by task</p>
          <h2 id="tasks-title">What are you trying to do?</h2>
        </header>

        <ul class="library-home__tasks">
          {
            tasks.map((task) => (
              <li>
                <a href={resolveRoute(locale, task.href)}>
                  <strong>{task.title}</strong>
                  <span>{task.description}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="library-home__section" aria-labelledby="updated-title">
        <header
          class="library-home__section-heading library-home__section-heading--row"
        >
          <div>
            <p class="library-home__eyebrow">Maintained reference</p>
            <h2 id="updated-title">Recently updated</h2>
          </div>
          <a href={resolveRoute(locale, "/blogs/")}>View all articles</a>
        </header>

        <ol class="library-home__updated">
          {
            recentlyUpdated.map((post) => {
              const topic = RESEARCH_TOPICS.find(
                (candidate) => candidate.id === post.data.topic,
              );
              const updated = post.data.updatedAt ?? post.data.publishDate;
              const reading = getBlogReadingStats(
                post.body ?? "",
                post.data.format,
              );

              return (
                <li>
                  <a href={resolveRoute(locale, `/blog/${post.id}/`)}>
                    <span class="library-home__updated-copy">
                      <strong>{post.data.title}</strong>
                      <span>{post.data.description}</span>
                    </span>
                    <dl>
                      <div>
                        <dt>Track</dt>
                        <dd>{topic?.shortTitle ?? "Reference"}</dd>
                      </div>
                      <div>
                        <dt>Level</dt>
                        <dd>{post.data.difficulty ?? "Not assigned"}</dd>
                      </div>
                      <div>
                        <dt>Last updated</dt>
                        <dd>{formatDate(updated)}</dd>
                      </div>
                      <div>
                        <dt>Review</dt>
                        <dd>
                          {post.data.reviewed_at
                            ? formatDate(post.data.reviewed_at)
                            : humanize(post.data.status)}
                        </dd>
                      </div>
                      <div>
                        <dt>Reading time</dt>
                        <dd>
                          {reading ? `${reading.minutes} min` : "Interactive"}
                        </dd>
                      </div>
                    </dl>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </section>

      <section
        class="library-home__standards"
        aria-labelledby="standards-title"
      >
        <header class="library-home__section-heading">
          <p class="library-home__eyebrow">Research standards</p>
          <h2 id="standards-title">Know what kind of claim you are reading</h2>
          <p>
            Technical statements should expose their evidence level, Windows
            version context, and unresolved uncertainty.
          </p>
        </header>

        <dl>
          {
            standards.map((standard) => (
              <div>
                <dt>{standard.term}</dt>
                <dd>{standard.definition}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </Container>
</Section>

<style>
  .library-home {
    display: grid;
    gap: var(--space-3xl);
  }

  .library-home__hero {
    display: grid;
    justify-items: start;
    max-width: var(--measure-reading-wide);
    padding-block: var(--space-xl) 0;
  }

  .library-home__eyebrow {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .library-home__hero h1 {
    max-width: 18ch;
    margin: var(--space-md) 0 0;
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .library-home__lead {
    max-width: 60ch;
    margin: var(--space-lg) 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-reading);
    line-height: var(--leading-reading);
  }

  .library-home__search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    width: min(100%, 42rem);
    min-height: var(--control-lg);
    margin-top: var(--space-xl);
    padding-inline: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .library-home__search:hover {
    border-color: var(--link);
  }

  .library-home__search:focus-visible,
  .library-home a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .library-home__search kbd {
    flex: none;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--muted);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .library-home__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .library-home__actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: var(--control-md);
    padding-inline: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--foreground);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .library-home__actions a:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .library-home__actions .library-home__primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .library-home__section {
    display: grid;
    gap: var(--space-xl);
  }

  .library-home__section-heading {
    max-width: var(--measure-reading);
  }

  .library-home__section-heading h2 {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .library-home__section-heading p:last-child {
    max-width: 64ch;
    margin: var(--space-md) 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .library-home__section-heading--row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    max-width: none;
  }

  .library-home__section-heading--row > a {
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-underline-offset: var(--space-xs);
  }

  .library-home__paths,
  .library-home__tasks,
  .library-home__updated {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .library-home__paths li,
  .library-home__updated li {
    border-bottom: 1px solid var(--border);
  }

  .library-home__paths a {
    display: grid;
    grid-template-columns: auto minmax(15rem, 0.8fr) minmax(24rem, 1.2fr) auto;
    gap: var(--space-xl);
    align-items: center;
    padding-block: var(--space-xl);
    color: inherit;
    text-decoration: none;
  }

  .library-home__paths a:hover,
  .library-home__updated a:hover {
    background: var(--muted);
  }

  .library-home__path-number {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .library-home__path-copy {
    display: grid;
    gap: var(--space-sm);
  }

  .library-home__path-copy strong {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .library-home__path-copy > span,
  .library-home__tasks a > span {
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .library-home__paths dl,
  .library-home__updated dl {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
  }

  .library-home__paths dl div,
  .library-home__updated dl div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-md);
  }

  .library-home__paths dt,
  .library-home__updated dt {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .library-home__paths dd,
  .library-home__updated dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .library-home__path-arrow {
    color: var(--link);
  }

  .library-home__tasks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .library-home__tasks li {
    border-bottom: 1px solid var(--border);
  }

  .library-home__tasks li:nth-child(odd) {
    border-right: 1px solid var(--border);
  }

  .library-home__tasks a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs) var(--space-xl);
    min-height: 8rem;
    padding: var(--space-lg);
    color: inherit;
    text-decoration: none;
  }

  .library-home__tasks a strong {
    font-size: var(--text-lg);
  }

  .library-home__tasks a > span:first-of-type {
    grid-column: 1;
  }

  .library-home__tasks a > span:last-child {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--link);
  }

  .library-home__tasks a:hover strong {
    color: var(--link);
  }

  .library-home__updated a {
    display: grid;
    grid-template-columns: minmax(20rem, 1.1fr) minmax(28rem, 0.9fr);
    gap: var(--space-2xl);
    padding-block: var(--space-lg);
    color: inherit;
    text-decoration: none;
  }

  .library-home__updated-copy {
    display: grid;
    gap: var(--space-xs);
  }

  .library-home__updated-copy strong {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .library-home__updated-copy > span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .library-home__updated dl {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-content: start;
  }

  .library-home__updated dl div {
    display: grid;
    grid-template-columns: none;
    gap: var(--space-xs);
  }

  .library-home__standards {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-3xl);
    padding-block: var(--space-2xl);
    border-block: 1px solid var(--border);
  }

  .library-home__standards dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    margin: 0;
  }

  .library-home__standards dl div {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .library-home__standards dt {
    font-weight: var(--font-weight-semibold);
  }

  .library-home__standards dd {
    margin: var(--space-xs) 0 0;
    color: var(--muted-foreground);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 72rem) {
    .library-home__paths a {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .library-home__paths dl {
      grid-column: 2;
    }

    .library-home__path-arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .library-home__updated a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 48rem) {
    .library-home {
      gap: var(--space-3xl);
    }

    .library-home__hero {
      padding-block-start: 0;
    }

    .library-home__search {
      align-items: flex-start;
    }

    .library-home__paths a {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-md);
    }

    .library-home__paths dl {
      grid-column: 2;
    }

    .library-home__path-arrow {
      display: none;
    }

    .library-home__tasks,
    .library-home__standards,
    .library-home__standards dl {
      grid-template-columns: minmax(0, 1fr);
    }

    .library-home__tasks li:nth-child(odd) {
      border-right: 0;
    }

    .library-home__section-heading--row {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .library-home__updated dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .library-home__search kbd {
      display: none;
    }

    .library-home__paths dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
    }

    .library-home__updated dl {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
