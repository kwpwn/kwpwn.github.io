---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import SEO from "../components/seo/SEO.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import { type Locale } from "../lib/site-config";
import { canonicalUrl, jsonLdFAQ } from "../lib/seo";
import { resolveRoute } from "../i18n/routes";
import { t } from "../i18n/ui";
import { siteConfig } from "../config/site.config";
import {
  getResearchTopic,
  getResearchTopicPosts,
} from "../lib/research-topics";
import {
  ArticleEvidence,
  ArticleGuide,
  ArticleHero,
  ArticleLibraryNav,
  ArticlePager,
  ArticleTools,
  RelatedPosts,
  TableOfContents,
} from "../components/blog/index";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  post: CollectionEntry<"blog">;
  locale: Locale;
  headings?: Heading[];
}

const { post, locale, headings = [] } = Astro.props as Props;
const publishDate = new Date(post.data.publishDate);
const updatedDate = post.data.updatedAt
  ? new Date(post.data.updatedAt)
  : publishDate;
const tags = post.data.tags ?? [];
const tocEnabled =
  siteConfig.articleFeatures.toc.enabled && post.data.toc !== false;
const allPosts = await getCollection("blog");
const topic = post.data.topic ? getResearchTopic(post.data.topic) : undefined;
const orderedTopicPosts = topic
  ? getResearchTopicPosts(allPosts, topic.id)
  : [];
const topicIndex = orderedTopicPosts.findIndex(
  (candidate) => candidate.id === post.id,
);
const previousPost =
  topicIndex > 0 ? orderedTopicPosts[topicIndex - 1] : undefined;
const nextPost =
  topicIndex >= 0 && topicIndex < orderedTopicPosts.length - 1
    ? orderedTopicPosts[topicIndex + 1]
    : undefined;
const breadcrumbItems = topic
  ? [
      {
        label: "Learning paths",
        href: resolveRoute(locale, "/topics/"),
      },
      {
        label: topic.shortTitle,
        href: resolveRoute(locale, `/topics/${topic.id}/`),
      },
      {
        label: post.data.title,
        href: canonicalUrl(locale, `/blog/${post.id}`),
      },
    ]
  : [
      { label: "Articles", href: resolveRoute(locale, "/blogs/") },
      {
        label: post.data.title,
        href: canonicalUrl(locale, `/blog/${post.id}`),
      },
    ];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: post.data.title,
    description: post.data.description,
    datePublished: publishDate.toISOString(),
    dateModified: updatedDate.toISOString(),
    author: {
      "@type": "Person",
      name: post.data.author,
    },
    mainEntityOfPage: canonicalUrl(locale, `/blog/${post.id}`),
    inLanguage: locale,
    articleSection: topic?.shortTitle ?? "Windows security research",
    keywords: tags.join(", "),
    citation: post.data.sources.map((source: { url: string }) => source.url),
  },
  ...(post.data.faqs?.length
    ? [
        jsonLdFAQ(
          post.data.faqs.map((faq: { question: string; answer: string }) => ({
            question: faq.question,
            answer: faq.answer,
          })),
        ),
      ]
    : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  locale={locale}
  path={`/blog/${post.id}`}
  showThemeToggle={true}
>
  <SEO
    slot="seo"
    title={post.data.title}
    description={post.data.description}
    locale={locale}
    path={`/blog/${post.id}`}
    ogImage={`/og/blog/${locale}/${post.id}`}
    article={{
      publishedTime: publishDate.toISOString(),
      modifiedTime: updatedDate.toISOString(),
      author: post.data.author,
      tags,
    }}
    jsonLd={jsonLd}
  />

  <article class="blog-layout container">
    <div
      class:list={[
        "blog-layout__shell",
        !tocEnabled && "blog-layout__shell--without-toc",
      ]}
    >
      <ArticleLibraryNav
        currentPost={post}
        allPosts={allPosts}
        locale={locale}
      />

      <div class="blog-layout__intro">
        <div data-pagefind-ignore>
          <Breadcrumbs crumbs={breadcrumbItems} />
        </div>
        <ArticleHero post={post} locale={locale} />
        <ArticleEvidence post={post} />
        <ArticleGuide post={post} />
      </div>

      {
        tocEnabled && (
          <aside class="blog-layout__toc">
            <TableOfContents
              headings={headings}
              layout="sidebar"
              maxDepth={siteConfig.articleFeatures.toc.maxDepth}
              minHeadings={siteConfig.articleFeatures.toc.minHeadings}
              title={t(locale, "blog.toc")}
              locale={locale}
            />
          </aside>
        )
      }

      <div class="blog-layout__body">
        <div
          class:list={[
            "blog-layout__article prose prose-gray dark:prose-invert",
            post.data.wide && "blog-layout__article--wide",
          ]}
        >
          <slot />
        </div>

        <ArticleTools post={post} />

        <div data-pagefind-ignore>
          <ArticlePager
            previous={previousPost}
            next={nextPost}
            locale={locale}
          />
          <RelatedPosts
            currentPost={post}
            allPosts={allPosts}
            locale={locale}
          />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-layout {
    max-width: var(--container-max);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .blog-layout__shell {
    display: grid;
    grid-template-columns:
      minmax(13rem, var(--library-nav-width))
      minmax(0, var(--article-measure))
      minmax(11rem, var(--article-toc-width));
    grid-template-areas:
      "library intro toc"
      "library body toc";
    gap: var(--space-xl) var(--library-rail-gap);
    align-items: start;
    justify-content: center;
  }

  .blog-layout__shell--without-toc {
    grid-template-columns:
      minmax(13rem, var(--library-nav-width))
      minmax(0, var(--article-measure));
    grid-template-areas:
      "library intro"
      "library body";
  }

  :global(.article-library-nav) {
    grid-area: library;
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
    max-height: calc(100vh - var(--header-height) - var(--space-xl));
    overflow-y: auto;
  }

  .blog-layout__intro {
    grid-area: intro;
    display: grid;
    gap: var(--space-xl);
    min-width: 0;
  }

  .blog-layout__toc {
    grid-area: toc;
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
    max-height: calc(100vh - var(--header-height) - var(--space-xl));
    overflow-y: auto;
  }

  .blog-layout__body {
    grid-area: body;
    display: grid;
    gap: var(--space-2xl);
    min-width: 0;
  }

  .blog-layout__article {
    width: 100%;
    max-width: var(--measure-reading);
    min-width: 0;
  }

  .blog-layout__article--wide {
    max-width: var(--measure-reading-wide);
  }

  @media (max-width: 79.99rem) {
    .blog-layout__shell {
      grid-template-columns:
        minmax(0, var(--article-measure))
        minmax(11rem, var(--article-toc-width));
      grid-template-areas:
        "library library"
        "intro toc"
        "body toc";
    }

    .blog-layout__shell--without-toc {
      grid-template-columns: minmax(0, var(--article-measure));
      grid-template-areas:
        "library"
        "intro"
        "body";
    }

    :global(.article-library-nav) {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 63.99rem) {
    .blog-layout {
      padding-block: var(--space-lg) var(--space-2xl);
    }

    .blog-layout__shell,
    .blog-layout__shell--without-toc {
      grid-template-columns: minmax(0, var(--article-measure));
      grid-template-areas:
        "library"
        "intro"
        "toc"
        "body";
      gap: var(--space-lg);
    }

    .blog-layout__toc {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  @media print {
    :global(.header),
    :global(.footer),
    :global(.article-library-nav),
    .blog-layout__toc,
    .blog-layout__intro > [data-pagefind-ignore],
    .blog-layout__body > [data-pagefind-ignore] {
      display: none;
    }

    .blog-layout {
      max-width: none;
      padding: 0;
    }

    .blog-layout__shell,
    .blog-layout__shell--without-toc {
      display: block;
    }

    .blog-layout__intro,
    .blog-layout__body {
      display: block;
    }

    .blog-layout__article,
    .blog-layout__article--wide {
      max-width: none;
    }
  }
</style>
