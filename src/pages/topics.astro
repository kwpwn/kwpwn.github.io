---
import ResearchTopicDirectory from "../components/sections/ResearchTopicDirectory.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = "en" as const;
const title = "Windows Security Research Topics";
const description =
  "Choose a structured learning path for Windows privilege escalation, malware and C2 analysis, or Windows internals.";
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path="/topics/"
>
  <ResearchTopicDirectory locale={locale} />
</BaseLayout>
